{
  "_comment": [
    "Canonical request-validation matrix for Evo2Serve.",
    "Both API layers are executed against this list:",
    "  evo2-backend/main.py            -> Pydantic VariantRequest (docs/analysis/d_validation_conformance.py)",
    "  evo2-frontend/src/app/api/analyze/route.ts -> Zod schema (docs/analysis/e_clinvar_conformance.mjs)",
    "'expect' states the intended contract of the deployed service, derived from",
    "the request schema and the documented limits, not from either implementation.",
    "A disagreement between the two layers is therefore a defect.",
    "A payload value of the form {\"$repeat\": {\"char\": \"A\", \"count\": 500, \"suffix\": \"     \"}}",
    "expands to the repeated character followed by the suffix, so that exact",
    "length boundaries can be expressed without hand-counting."
  ],
  "base": {
    "variant_position": 43119628,
    "genome": "hg38",
    "chromosome": "chr17"
  },
  "cases": [
    { "name": "snv/uppercase A", "expect": "accept", "payload": { "variant_type": "snv", "alternative": "A" } },
    { "name": "snv/uppercase T", "expect": "accept", "payload": { "variant_type": "snv", "alternative": "T" } },
    { "name": "snv/uppercase C", "expect": "accept", "payload": { "variant_type": "snv", "alternative": "C" } },
    { "name": "snv/uppercase G", "expect": "accept", "payload": { "variant_type": "snv", "alternative": "G" } },
    { "name": "snv/lowercase g", "expect": "accept", "payload": { "variant_type": "snv", "alternative": "g" } },
    { "name": "snv/alternative with whitespace", "expect": "accept", "payload": { "variant_type": "snv", "alternative": " G " } },
    { "name": "snv/alternative N", "expect": "reject", "payload": { "variant_type": "snv", "alternative": "N" } },
    { "name": "snv/alternative empty", "expect": "reject", "payload": { "variant_type": "snv", "alternative": "" } },
    { "name": "snv/alternative two bases", "expect": "reject", "payload": { "variant_type": "snv", "alternative": "AT" } },
    { "name": "snv/alternative missing", "expect": "reject", "payload": { "variant_type": "snv" } },
    { "name": "snv/with deletion_length", "expect": "reject", "payload": { "variant_type": "snv", "alternative": "A", "deletion_length": 3 } },
    { "name": "snv/with inserted_sequence", "expect": "reject", "payload": { "variant_type": "snv", "alternative": "A", "inserted_sequence": "TT" } },

    { "name": "deletion/length 1", "expect": "accept", "payload": { "variant_type": "deletion", "deletion_length": 1 } },
    { "name": "deletion/length 500", "expect": "accept", "payload": { "variant_type": "deletion", "deletion_length": 500 } },
    { "name": "deletion/length 0", "expect": "reject", "payload": { "variant_type": "deletion", "deletion_length": 0 } },
    { "name": "deletion/length 501", "expect": "reject", "payload": { "variant_type": "deletion", "deletion_length": 501 } },
    { "name": "deletion/length negative", "expect": "reject", "payload": { "variant_type": "deletion", "deletion_length": -1 } },
    { "name": "deletion/length missing", "expect": "reject", "payload": { "variant_type": "deletion" } },
    { "name": "deletion/with alternative", "expect": "reject", "payload": { "variant_type": "deletion", "deletion_length": 3, "alternative": "A" } },
    { "name": "deletion/with alternative dash", "expect": "accept", "payload": { "variant_type": "deletion", "deletion_length": 3, "alternative": "-" } },
    { "name": "deletion/with inserted_sequence", "expect": "reject", "payload": { "variant_type": "deletion", "deletion_length": 3, "inserted_sequence": "TT" } },

    { "name": "insertion/single base", "expect": "accept", "payload": { "variant_type": "insertion", "inserted_sequence": "A" } },
    { "name": "insertion/lowercase", "expect": "accept", "payload": { "variant_type": "insertion", "inserted_sequence": "acgt" } },
    { "name": "insertion/with spaces", "expect": "accept", "payload": { "variant_type": "insertion", "inserted_sequence": "A C G T" } },
    { "name": "insertion/whitespace only", "expect": "reject", "payload": { "variant_type": "insertion", "inserted_sequence": "   " } },
    { "name": "insertion/empty", "expect": "reject", "payload": { "variant_type": "insertion", "inserted_sequence": "" } },
    { "name": "insertion/contains N", "expect": "reject", "payload": { "variant_type": "insertion", "inserted_sequence": "ACGN" } },
    { "name": "insertion/contains X", "expect": "reject", "payload": { "variant_type": "insertion", "inserted_sequence": "ACGTX" } },
    { "name": "insertion/500 bases", "expect": "accept", "payload": { "variant_type": "insertion", "inserted_sequence": { "$repeat": { "char": "A", "count": 500 } } } },
    { "name": "insertion/495 bases plus 5 spaces", "expect": "accept", "payload": { "variant_type": "insertion", "inserted_sequence": { "$repeat": { "char": "A", "count": 495, "suffix": "     " } } } },
    { "name": "insertion/501 raw characters", "expect": "reject", "payload": { "variant_type": "insertion", "inserted_sequence": { "$repeat": { "char": "A", "count": 501 } } } },
    { "name": "insertion/495 bases plus 6 spaces", "expect": "reject", "payload": { "variant_type": "insertion", "inserted_sequence": { "$repeat": { "char": "A", "count": 495, "suffix": "      " } } } },
    { "name": "insertion/sequence missing", "expect": "reject", "payload": { "variant_type": "insertion" } },
    { "name": "insertion/with deletion_length", "expect": "reject", "payload": { "variant_type": "insertion", "inserted_sequence": "TT", "deletion_length": 2 } },
    { "name": "insertion/with alternative", "expect": "reject", "payload": { "variant_type": "insertion", "inserted_sequence": "TT", "alternative": "A" } },

    { "name": "delins/valid", "expect": "accept", "payload": { "variant_type": "delins", "deletion_length": 2, "inserted_sequence": "TT" } },
    { "name": "delins/length 500", "expect": "accept", "payload": { "variant_type": "delins", "deletion_length": 500, "inserted_sequence": "TT" } },
    { "name": "delins/length 501", "expect": "reject", "payload": { "variant_type": "delins", "deletion_length": 501, "inserted_sequence": "TT" } },
    { "name": "delins/length 0", "expect": "reject", "payload": { "variant_type": "delins", "deletion_length": 0, "inserted_sequence": "TT" } },
    { "name": "delins/inserted_sequence missing", "expect": "reject", "payload": { "variant_type": "delins", "deletion_length": 2 } },
    { "name": "delins/deletion_length missing", "expect": "reject", "payload": { "variant_type": "delins", "inserted_sequence": "TT" } },
    { "name": "delins/with alternative", "expect": "reject", "payload": { "variant_type": "delins", "deletion_length": 2, "inserted_sequence": "TT", "alternative": "A" } },

    { "name": "shared/default variant_type is snv", "expect": "accept", "payload": { "alternative": "A" } },
    { "name": "shared/unknown variant_type", "expect": "reject", "payload": { "variant_type": "snv2", "alternative": "A" } },
    { "name": "shared/position zero", "expect": "reject", "payload": { "variant_position": 0, "alternative": "A" } },
    { "name": "shared/position negative", "expect": "reject", "payload": { "variant_position": -5, "alternative": "A" } },
    { "name": "shared/position not an integer", "expect": "reject", "payload": { "variant_position": 1.5, "alternative": "A" } },
    { "name": "shared/genome empty", "expect": "reject", "payload": { "genome": "", "alternative": "A" } },
    { "name": "shared/chromosome empty", "expect": "reject", "payload": { "chromosome": "", "alternative": "A" } },
    { "name": "shared/genome with UCSC parameter separator", "expect": "reject", "payload": { "genome": "hg38;hubUrl=http://example.invalid", "alternative": "A" } },
    { "name": "shared/chromosome with UCSC parameter separator", "expect": "reject", "payload": { "chromosome": "chr17;start=0", "alternative": "A" } },
    { "name": "shared/genome with newline", "expect": "reject", "payload": { "genome": "hg38\n", "alternative": "A" } },
    { "name": "shared/chromosome with slash", "expect": "reject", "payload": { "chromosome": "chr17/../chr1", "alternative": "A" } },
    { "name": "shared/genome with space", "expect": "reject", "payload": { "genome": "hg38 ", "alternative": "A" } },
    { "name": "shared/chromosome with space", "expect": "reject", "payload": { "chromosome": "chr 17", "alternative": "A" } }
  ]
}
